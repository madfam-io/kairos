# NLP Service Configuration

# Server settings
NLP_HOST=0.0.0.0
NLP_PORT=8000
NLP_WORKERS=1
NLP_DEBUG=false

# Data paths
NLP_CEDICT_PATH=data/cedict_ts.u8
NLP_HSK_PATH=data/hsk.json

# Cache (optional)
NLP_REDIS_URL=redis://localhost:6379
NLP_CACHE_TTL=86400

# Rate limiting
NLP_RATE_LIMIT_REQUESTS=100
NLP_RATE_LIMIT_WINDOW=60

# Model settings
NLP_LAC_MODE=lac
