{
  "name": "@kairos/extension",
  "displayName": "Kairos - Chinese Immersion",
  "version": "0.1.0",
  "private": true,
  "description": "The Intelligent Chinese Immersion Engine - Learn Chinese through native content",
  "author": "Kairos Team",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "build:chrome": "plasmo build --target=chrome-mv3",
    "build:firefox": "plasmo build --target=firefox-mv3",
    "package": "plasmo package",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "clean": "rm -rf build .plasmo .turbo"
  },
  "dependencies": {
    "@kairos/types": "workspace:*",
    "@plasmohq/messaging": "^0.6.2",
    "@plasmohq/storage": "^1.12.0",
    "@tanstack/react-query": "^5.62.0",
    "clsx": "^2.1.1",
    "framer-motion": "^11.13.1",
    "lucide-react": "^0.460.0",
    "plasmo": "^0.89.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.4.0",
    "@types/chrome": "^0.0.279",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.7.2",
    "vitest": "^2.1.6"
  },
  "manifest": {
    "host_permissions": [
      "https://*.netflix.com/*",
      "https://*.youtube.com/*",
      "https://api.kairos.dev/*"
    ],
    "permissions": [
      "storage",
      "activeTab",
      "scripting"
    ],
    "web_accessible_resources": [
      {
        "resources": [
          "assets/*"
        ],
        "matches": [
          "https://*.netflix.com/*",
          "https://*.youtube.com/*"
        ]
      }
    ]
  }
}
