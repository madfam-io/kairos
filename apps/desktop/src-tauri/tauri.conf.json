{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kairos",
  "version": "0.1.0",
  "identifier": "dev.kairos.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Kairos",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "category": "Education",
    "shortDescription": "Intelligent Chinese Immersion Engine",
    "longDescription": "Learn Chinese through native video content with AI-powered sentence simplification and spaced repetition.",
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "wix": null,
      "nsis": null
    }
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "fs": {
      "all": true,
      "scope": ["$HOME/**", "$APPDATA/**", "$DOCUMENT/**", "$VIDEO/**"]
    }
  }
}
