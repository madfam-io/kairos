    "@tanstack/react-query": "^5.59.0",
    "expo": "~52.0.0",
    "expo-av": "~14.0.0",
    "expo-constants": "~17.0.0",
    "expo-file-system": "~18.0.0",
    "expo-font": "~13.0.0",
    "expo-haptics": "~14.0.0",
