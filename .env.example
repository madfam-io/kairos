# Kairos Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# Database (PostgreSQL)
# =============================================================================
DATABASE_URL=postgres://kairos:kairos@localhost:5432/kairos
POSTGRES_USER=kairos
POSTGRES_PASSWORD=kairos
POSTGRES_DB=kairos

# =============================================================================
# Redis (Local) or Upstash (Production)
# =============================================================================
REDIS_URL=redis://localhost:6379

# Upstash Redis REST API (recommended for production)
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# =============================================================================
# Janua Authentication
# https://github.com/madfam-io/janua
# =============================================================================
JANUA_API_URL=http://localhost:4000
JANUA_PUBLISHABLE_KEY=pk_your_publishable_key
JANUA_JWT_SECRET=your_jwt_secret_key

# =============================================================================
# Payment Providers (via Janua plugins)
# All providers handled through Janua - configure only the ones you need
# =============================================================================

# Stripe (Default for US/EU/Global)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PRODUCT_LEARNER=price_learner_monthly
STRIPE_PRODUCT_IMMERSION=price_immersion_monthly

# Conekta (Mexico/LATAM)
CONEKTA_API_KEY=key_your_conekta_api_key
CONEKTA_WEBHOOK_KEY=your_conekta_webhook_key
CONEKTA_PRODUCT_LEARNER=plan_learner
CONEKTA_PRODUCT_IMMERSION=plan_immersion

# Polar (Open Source friendly)
POLAR_ACCESS_TOKEN=your_polar_access_token
POLAR_ORGANIZATION_ID=your_polar_org_id
POLAR_PRODUCT_LEARNER=prod_learner
POLAR_PRODUCT_IMMERSION=prod_immersion

# =============================================================================
# Hugging Face (for model downloads)
# =============================================================================
HF_TOKEN=hf_your_huggingface_token

# =============================================================================
# AI Services (Docker/Enclii)
# =============================================================================
NLP_SERVICE_URL=http://nlp:8000
SIMPLIFY_SERVICE_URL=http://simplify:8001
PITCH_SERVICE_URL=http://pitch:8002
SPEECH_SERVICE_URL=http://speech:8003

# =============================================================================
# Application
# =============================================================================
APP_URL=http://localhost:3000
NODE_ENV=development

# =============================================================================
# Observability (Optional)
# =============================================================================
# Logging
LOG_LEVEL=info  # trace, debug, info, warn, error, fatal

# Sentry Error Tracking
SENTRY_DSN=https://...@sentry.io/...

# PostHog Analytics
POSTHOG_KEY=phc_...
POSTHOG_HOST=https://app.posthog.com

# =============================================================================
# Security
# =============================================================================
# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://app.kairos.dev

# API Secret (for internal services)
API_SECRET=your_api_secret_at_least_32_chars
